# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
RAILRADAR_API_KEY=rr_live_xxxxxxxx
# Free plan = 1000 requests/month. Stop a little short so we never hit 429.
RAILRADAR_MONTHLY_CAP=950
# A train's live status is reused for this many minutes before RailRadar is called again.
LIVE_CACHE_MINUTES=10
# Optional: if set, the apps must send header  X-App-Key: <value>
APP_API_KEY=
