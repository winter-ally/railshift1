# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAILSHIFT_API_URL: Base URL for live train tracking backend
RAILSHIFT_API_URL=https://railshift1.onrender.com

# RAILSHIFT_APP_KEY: Application API key (sent as X-App-Key header)
# Configure this in the AI Studio Secrets panel or your local .env file.
RAILSHIFT_APP_KEY=placeholder
